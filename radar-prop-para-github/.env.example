# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube al repositorio.

# Base de datos. Local con docker: postgresql+psycopg://radar:radar_local@db:5432/radar
# Supabase: Project Settings > Database > Connection string > "Session pooler" (cambiá postgresql:// por postgresql+psycopg://)
DATABASE_URL=
POSTGRES_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# Seguridad (Fase 2). JWT_SECRET: texto largo y aleatorio (por ejemplo: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://radarprop.app
APP_URL=https://radarprop.app
ACCESS_MINUTOS=15
REFRESH_DIAS=30
LOGIN_MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
AUTH_PEDIDOS_POR_MINUTO=20

# Puente con el panel de fichas (Netlify badenheuer-fichas)
PANEL_URL=https://badenheuer-fichas.netlify.app
PANEL_RUTA=/panel-8yyp70b939mf/
PANEL_TOKEN=

# Análisis con IA (opcional)
IA_API_KEY=
